# ── Required ────────────────────────────────────────────────────────────────

# Supabase (Postgres + storage). Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service_role key — server-only. Powers /api/rpc, automations, MCP, REST API.
SUPABASE_SERVICE_ROLE_KEY=

# Privy (auth) — https://dashboard.privy.io → your app id.
NEXT_PUBLIC_PRIVY_APP_ID=

# Public URL of this deployment (used in emails and share links).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Recommended ─────────────────────────────────────────────────────────────

# Encrypts stored BYO AI keys and integration secrets (AES-256-GCM).
# Generate: openssl rand -base64 32
# If unset, a key is derived from SUPABASE_SERVICE_ROLE_KEY as a fallback.
SECRETS_MASTER_KEY=

# ── Optional: email (candidate status + messaging) ──────────────────────────
RESEND_API_KEY=
RESEND_FROM="HireBTR <notifications@yourdomain.com>"

# ── Optional: billing (Stripe) ───────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_STARTER_PRICE_ID=
NEXT_PUBLIC_STRIPE_PRO_PRICE_ID=

# ── Optional: Google Calendar (interview scheduling) ─────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# ── Optional: privacy-friendly web analytics module ──────────────────────────
NEXT_PUBLIC_ANALYTICS_SITE_ID=
# Salt for hashing visitor IPs. Generate: openssl rand -hex 16
ANALYTICS_SALT=

# ── Optional: KSeF e-invoicing (Poland) ──────────────────────────────────────
KSEF_BASE_URL=
KSEF_PUBLIC_KEY_PEM=
KSEF_MASTER_KEY=
