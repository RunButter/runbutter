# ── Required ────────────────────────────────────────────────────────────────

# Supabase (Postgres + storage). Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service_role key — server-only. Powers /api/rpc, automations, MCP, REST API.
SUPABASE_SERVICE_ROLE_KEY=

# Privy (auth) — https://dashboard.privy.io → your app id.
NEXT_PUBLIC_PRIVY_APP_ID=

# Server-only override for the Supabase URL. Leave EMPTY on a normal install —
# the server then uses NEXT_PUBLIC_SUPABASE_URL, which is correct everywhere the
# browser and the server can reach the same address.
#
# It exists for `docker compose`, where they genuinely differ: the browser must
# be told http://localhost:8000 (and NEXT_PUBLIC_* is compiled into the bundle,
# so it cannot be a container name), while inside the app container that address
# is the app itself. The compose file sets this to http://gateway:8000.
SUPABASE_URL=

# Public URL of this deployment (used in emails and share links).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Recommended ─────────────────────────────────────────────────────────────

# Encrypts stored BYO AI keys and integration secrets (AES-256-GCM).
# Generate: openssl rand -base64 32
# If unset, a key is derived from SUPABASE_SERVICE_ROLE_KEY as a fallback.
SECRETS_MASTER_KEY=

# ── Optional: email (candidate status + messaging) ──────────────────────────
RESEND_API_KEY=
RESEND_FROM="RunButter <notifications@yourdomain.com>"

# ── Optional: billing (Stripe) ───────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# One Stripe price id per paid plan. Both are PER SEAT — the checkout sends the
# seat count as the quantity, so create recurring prices, not flat ones.
# Changing your pricing means NEW price ids here and a redeploy: NEXT_PUBLIC_*
# values are inlined into the browser bundle at build time.
NEXT_PUBLIC_STRIPE_TEAM_PRICE_ID=
NEXT_PUBLIC_STRIPE_BUSINESS_PRICE_ID=
# Pre-pivot names, still read as a fallback so an older deployment keeps working.
# Remove them once the two above are set.
NEXT_PUBLIC_STRIPE_STARTER_PRICE_ID=
NEXT_PUBLIC_STRIPE_PRO_PRICE_ID=

# ── Optional: Google Calendar (interview scheduling) ─────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# ── Optional: privacy-friendly web analytics module ──────────────────────────
NEXT_PUBLIC_ANALYTICS_SITE_ID=
# Salt for hashing visitor IPs. Generate: openssl rand -hex 16
ANALYTICS_SALT=

# ── Optional: Product Hunt badge in the marketing footer ─────────────────────
# COPY BOTH VALUES OUT OF PRODUCT HUNT'S OWN EMBED SNIPPET. Do not build the URL
# yourself: the familiar producthunt.com/posts/<slug> shape now redirects to a
# page that 512s, and only the canonical /products/<slug>/launches/<slug>
# address in their snippet works.
#
#   POST_ID  the number in  featured.svg?post_id=THIS
#   URL      the whole href on the surrounding <a>, query string and all
#
# Careful: a Product Hunt PRODUCT id and a launch POST id are different numbers
# with near-identical snippets, and the wrong one renders a broken image rather
# than an error. This wants the POST id.
#
# Both default to RunButter's own — in a fork set them EMPTY or your footer
# advertises us. Both are NEXT_PUBLIC_*, so a change needs a REDEPLOY: the value
# is compiled into the bundle, not read at runtime.
NEXT_PUBLIC_PRODUCT_HUNT_POST_ID=
NEXT_PUBLIC_PRODUCT_HUNT_URL=

# ── Optional: KSeF e-invoicing (Poland) ──────────────────────────────────────
KSEF_BASE_URL=
KSEF_PUBLIC_KEY_PEM=
KSEF_MASTER_KEY=

# ── Optional: absolute URL of this deployment ────────────────────────────────
# Used to build links that leave the app: newsletter unsubscribe and click
# tracking, the spreadsheet feed URL, and OAuth redirects. Without it those
# links point at the wrong host, which silently breaks every unsubscribe.
# (A server-only SITE_URL is accepted as a fallback if you prefer not to
# expose it to the browser bundle.)
NEXT_PUBLIC_SITE_URL=
# Bare hostname, for the per-company careers subdomains (e.g. runbutter.app).
NEXT_PUBLIC_ROOT_DOMAIN=

# ── Optional: cron authentication ────────────────────────────────────────────
# Shared secret for the scheduled endpoints that DON'T take the service-role
# key: /api/finance/reminders/run and /api/excel/sync. Generate:
#   openssl rand -hex 32
# The sweep endpoints refuse to run when this is unset — an unauthenticated job
# that mails customers or writes into people's workbooks is not a safe default.
CRON_SECRET=

# ── Optional: newsletters (delivery feedback) ────────────────────────────────
# Signing secret for the Resend webhook on /api/newsletters/webhook. Subscribe
# it to email.bounced and email.complained: without this, bounces never
# suppress, and a sending domain's reputation goes with it.
RESEND_WEBHOOK_SECRET=

# ── Optional: two-way Excel sync (Microsoft Graph) ───────────────────────────
# Register an app at entra.microsoft.com with the redirect URI
#   <NEXT_PUBLIC_SITE_URL>/api/auth/microsoft/callback
# and delegated permissions: offline_access, User.Read, Files.ReadWrite.
# Leave empty and the panel simply says the integration isn't configured.
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# 'common' (default) covers personal and work accounts; set a tenant id to
# restrict sign-in to one organisation.
MS_TENANT_ID=

# ── Optional: social publishing (0082/0083) ──────────────────────────────────
# Without these the Connect buttons in Settings → Integrations return a plain
# "not set up on this server" rather than failing at the platform. Each is a
# normal OAuth app you create on the platform's developer site; the redirect URI
# to register is <NEXT_PUBLIC_SITE_URL>/api/social/callback/<provider>, so
# NEXT_PUBLIC_SITE_URL must be right or the grant comes back to the wrong host.
#
# LinkedIn: scopes openid, profile, w_member_social. Standard apps get NO
# refresh token, so a connection has to be re-authorised roughly every 60 days —
# the panel flags it rather than failing scheduled posts silently.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# X: OAuth 2.0 with PKCE. Refresh tokens rotate on every use.
X_CLIENT_ID=
X_CLIENT_SECRET=

# ── Optional: OCR for scanned PDFs ───────────────────────────────────────────
# Self-hosted MinerU. Deliberately not a metered OCR API — see
# docs/file-extraction.md. Without it, scans are marked 'skipped' with a reason
# rather than silently indexed as empty.
MINERU_URL=
MINERU_TOKEN=
# Alternative: any OpenAI-compatible vision endpoint, on your own key.
OCR_API_URL=
OCR_API_KEY=
OCR_MODEL=

# ── Optional: Umami analytics (session metrics only) ─────────────────────────
# Only worth deploying for bounce rate / visit duration / funnels — countries,
# cities, browsers and OS already come from the built-in pipeline. See
# docs/umami-deploy.md. The credential is instance-wide, so it stays
# server-side and /api/analytics/* re-checks workspace membership in Postgres.
UMAMI_URL=
UMAMI_USERNAME=
UMAMI_PASSWORD=
UMAMI_API_KEY=

# ── Optional: GitHub token for the skill importer ────────────────────────────
# Agents → Skills → "Import from GitHub" reads public SKILL.md files. Without a
# token GitHub allows 60 API requests an hour PER IP, and on a hosted deployment
# that IP is the server's — so everyone on the instance shares one budget and a
# few imports exhaust it for all of them ("GitHub allows this server 60 API
# requests an hour and they are used up"). Any token works, including one with
# NO scopes ticked: this only ever reads public repositories. Raises the limit
# to 5,000/hour.
GITHUB_TOKEN=
