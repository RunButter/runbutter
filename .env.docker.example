# RunButter, self-hosted — copy to `.env` and fill in two things.
#
#   cp .env.docker.example .env
#   node scripts/gen-keys.mjs --env >> .env    # secrets, generated
#   # then paste your Privy app id below
#   docker compose up
#
# Everything not mentioned here is off, and says so when you try to use it.

# ── 1. The one thing that is not self-hosted ────────────────────────────────
# Authentication is Privy. It is a hosted service and there is no way around
# that in this stack, so it is stated up front rather than discovered halfway
# through: get a free app id at https://dashboard.privy.io (two minutes, no
# card). Nothing else leaves your machine.
#
# Login does not work without this, and there is no fallback anywhere in the
# app — a wrong value fails at the login screen, not at build time.
PRIVY_APP_ID=

# ── 2. Secrets ──────────────────────────────────────────────────────────────
# Generate all five: `node scripts/gen-keys.mjs --env >> .env`
#
# Do not copy these from a tutorial. SUPABASE_SERVICE_KEY bypasses row-level
# security on every table, and the well-known demo keys from Supabase's own
# self-host guide are exactly that key, published.
JWT_SECRET=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
# Seals BYO AI keys and social publishing tokens at rest. Rotating it makes
# everything already sealed undecryptable — people simply re-add their keys.
SECRETS_MASTER_KEY=
# Authenticates the finance-reminder and Excel sweeps. Without it they refuse
# to run, which is the right default for an endpoint that emails customers.
CRON_SECRET=

# ── 3. Where it runs ────────────────────────────────────────────────────────
# The browser talks to the gateway directly, so this must be reachable FROM THE
# BROWSER — `localhost` for a laptop, a real hostname if you put this behind a
# domain. It is baked into the JS bundle at build time (Next inlines
# NEXT_PUBLIC_*), so changing it means `docker compose build app` again.
PUBLIC_SUPABASE_URL=http://localhost:8000
PUBLIC_SITE_URL=http://localhost:3000

APP_PORT=3000
SUPABASE_PORT=8000
POSTGRES_PASSWORD=postgres

# ── 4. Optional — each switches on one feature ──────────────────────────────
# Email: invoice reminders, newsletters, candidate mail. https://resend.com
RESEND_API_KEY=
# Billing. Without it the plan pages render and checkout does nothing.
STRIPE_SECRET_KEY=

# Social publishing (0082/0083). Register the redirect URI
# <PUBLIC_SITE_URL>/api/social/callback/<provider> on each platform.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=

# Two-way Excel sync (0079).
MS_CLIENT_ID=
MS_CLIENT_SECRET=

# AI is BYO-key and configured per workspace in the app (Settings → AI keys),
# not here — so an agent spends the workspace's own credit and this file never
# holds a model provider secret.
